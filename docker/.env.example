# ---------------------------------------------------------------------------
# Variables de UNA implantación (un ayuntamiento). Copiar a .env y rellenar.
# No uses '%' en ningún valor: CKAN no arranca (interpola las variables CKAN_*).
# Lo común a todos los portales está fijado en la imagen (docker/ckan/Dockerfile).
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ogov-ckan
# production (por defecto) | development: en desarrollo los secretos débiles solo avisan
OGOV_ENV=production

# Puerto público del proxy y URL pública del portal
NGINX_PORT=8080
CKAN_SITE_URL=http://localhost:8080
CKAN__SITE_TITLE=Portal de Datos Abiertos
CKAN__SITE_ID=ogov-demo

# Claves secretas: generar UNA vez por portal y no cambiarlas
# (python3 -c 'import secrets;print(secrets.token_urlsafe(48))')
CKAN_SECRET_KEY=
CKAN_JWT_SECRET=

# Administrador inicial
CKAN_SYSADMIN_NAME=ckan_admin
# Mínimo 12 caracteres; el arranque rechaza valores de ejemplo
CKAN_SYSADMIN_PASSWORD=
CKAN_SYSADMIN_EMAIL=admin@example.org

# Federación datos.gob.es (ckanext-ogovtech_fixes)
CKANEXT__OGOVTECH__DIR3_CODE=
CKANEXT__OGOVTECH__SPATIAL_URI=
CKANEXT__OGOVTECH__CATALOG_ISSUED=

# Base de datos
POSTGRES_PASSWORD=
CKAN_DB=ckandb
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=
DATASTORE_DB=datastore
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=

# Correo saliente (opcional)
CKAN_SMTP_SERVER=
CKAN_SMTP_USER=
CKAN_SMTP_PASSWORD=
CKAN_SMTP_MAIL_FROM=
